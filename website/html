<!DOCTYPE html>
<html>
<head>
  <title>About Us</title>

  <!-- CSS Styling -->
  <style>

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    color: #2c3e50;
    text-align: center;
    min-height: 100vh;
  }

  nav {
    background: #004d40;
    padding: 15px 30px;
    text-align: left;
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  nav a {
    color: white;
    text-decoration: none;
    margin-right: 25px;
    font-weight: bold;
    transition: 0.3s;
  }

  nav a:hover {
    color: #80cbc4;
    border-bottom: 2px solid #80cbc4;
  }

  header {
    background: linear-gradient(to right, #00695c, #26a69a);
    color: white;
    padding: 80px 20px;
    animation: fadeIn 1.5s ease-in-out;
  }

  header h1 {
    font-size: 3rem;
    margin-bottom: 15px;
  }

  .container {
    max-width: 900px;
    margin: 40px auto;
    padding: 40px;
    background: white;
    border-radius: 20px;
    box-shadow: 0 15px 35px rgba(0,0,0,0.12);
    animation: slideUp 1.2s ease;
  }

  button {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
    border: none;
    padding: 14px 32px;
    border-radius: 30px;
    cursor: pointer;
    margin-top: 20px;
  }

  img {
    width: 100%;
    max-width: 600px;
    margin: 30px auto;
    border-radius: 15px;
  }

  .team {
    display: flex;
    justify-content: center;
    gap: 25px;
    flex-wrap: wrap;
    margin: 30px auto;
  }

  .card {
    background: white;
    padding: 25px;
    width: 250px;
    border-radius: 15px;
    box-shadow: 0 6px 15px rgba(0,0,0,0.1);
  }

  .card ul {
    list-style: none;
    text-align: left;
  }

  .card li:before {
    content: "✓ ";
    color: #667eea;
  }

  footer {
    background-color: #333;
    color: white;
    padding: 20px;
    margin-top: 40px;
  }

  .highlight {
    color: #00796b;
    transform: scale(1.1);
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  </style>
</head>

<body>

  <!-- Navigation -->
  <nav>
    <a href="index.html">Home</a>
    <a href="about.html">About</a>
    <a href="contactus.html">Contact Us</a>
  </nav>

  <!-- Header -->
  <header>
    <h1>About Us</h1>
    <p>We create simple, modern and easy-to-use websites.</p>
  </header>

  <!-- Content -->
  <div class="container">
    <h2 id="story">Our Story</h2>
    <p>
      We are a small creative team who enjoy building websites that are clean,
      accessible and user-friendly. Our goal is to help people bring their ideas
      online through simple and effective web design.
    </p>

    <button onclick="showMessage()">Click Me</button>
  </div>

  <!-- Team Image -->
  <img src="images/team.jpg" alt="Our Team">

  <!-- Team Section -->
  <h2 id="team-title">Our Team</h2>

  <div class="team">
    <div class="card">
      <h3>Alex</h3>
      <p>Developer</p>
      <p>Skills</p>
      <ul>
        <li>Strong python coding skills</li>
        <li>Strong problem-solving abilities</li>
        <li>Responsive design expertise</li>
      </ul>
    </div>

    <div class="card">
      <h3>Jordan</h3>
      <p>Designer</p>
      <p>Skills</p>
      <ul>
        <li>UI/UX Design</li>
        <li>Prototyping</li>
        <li>Brand Identity</li>
      </ul>
    </div>

    <div class="card">
      <h3>Taylor</h3>
      <p>Project Manager</p>
      <p>Skills</p>
      <ul>
        <li>Leadership</li>
        <li>Communication</li>
        <li>Time Management</li>
      </ul>
    </div>
  </div>

  <!-- Footer -->
  <footer>
    <p>&copy; 2026 Our Simple Site. All rights reserved.</p>
  </footer>

  <!-- JavaScript -->
  <script>
    function showMessage() {
      alert("Welcome to our modern About Us page!");

      let storyTitle = document.getElementById("story");
      storyTitle.classList.add("highlight");

      setTimeout(function() {
        storyTitle.classList.remove("highlight");
      }, 1500);
    }

    window.onload = function() {
      let teamTitle = document.getElementById("team-title");
      teamTitle.style.opacity = "0";
      teamTitle.style.transition = "opacity 1.5s";

      setTimeout(function() {
        teamTitle.style.opacity = "1";
      }, 500);
    };
  </script>

</body>
</html>